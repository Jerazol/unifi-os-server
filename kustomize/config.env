# Must match the version of the image.
APP_VERSION=5.1.42

# Identity of this installation. Written to /data/uos_uuid on the first start; changing it later has no effect.
# Must NOT be a random (version 4) UUID, or the Network application fails with "Invalid uuid version - 4".
# Generate a version 5 UUID, for example:
#   uuidgen --sha1 --namespace @dns --name unifi.example.com
#   python3 -c 'import uuid; print(uuid.uuid5(uuid.NAMESPACE_DNS, "unifi.example.com"))'
UOS_UUID=CHANGE-ME
